# Copy this file to .env.local and fill in your own Supabase project values.
# Find these in your Supabase project: Settings > API

NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key

# Service role key — needed ONLY by the Razorpay webhook to update a
# person's plan after payment. Find it in Supabase: Settings > API >
# service_role key. NEVER expose this to the browser (no NEXT_PUBLIC_
# prefix) and never commit it — it bypasses all Row Level Security.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Razorpay — create an account at https://dashboard.razorpay.com, then
# Settings > API Keys to generate these. Until you fill these in, the
# upgrade/checkout flow will show an error rather than a broken payment
# form, so the rest of the app works fine without them.
RAZORPAY_KEY_ID=your-razorpay-key-id
RAZORPAY_KEY_SECRET=your-razorpay-key-secret
# Only used to verify webhook calls are genuinely from Razorpay — set this
# to the same secret you configure in the Razorpay Dashboard webhook setup.
RAZORPAY_WEBHOOK_SECRET=your-razorpay-webhook-secret
# The publishable key ID is also needed client-side to open the Razorpay
# checkout popup — safe to expose, unlike the secret above.
NEXT_PUBLIC_RAZORPAY_KEY_ID=your-razorpay-key-id
